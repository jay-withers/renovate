{
  "name": "generic",
  "image": "ghcr.io/jay-withers/dev-containers/base:latest@sha256:5a4e2e9ee691f9a0ce7e465ea97282b9e536466b582b74e4e2afad2f33c9341d",
  "mounts": [
    "source=${localEnv:HOME}/Git,target=/Users/jay/Git,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make install"
}
