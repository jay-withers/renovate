{
  "name": "generic",
  "image": "ghcr.io/jay-withers/dev-containers/base:latest@sha256:f0e0fd14f2e65b1d8d5156561b6242e922e69e1490e37108562264853488b7b7",
  "mounts": [
    "source=${localEnv:HOME}/Git,target=/Users/jay/Git,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make install"
}
