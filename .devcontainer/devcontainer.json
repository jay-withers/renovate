{
  "name": "generic",
  "image": "ghcr.io/jay-withers/dev-containers/base:latest@sha256:8ecb8c5ca2a24c21e9c9b00b158659e0437dd2003e2078e1921c8d82f6c6f3f6",
  "mounts": [
    "source=${localEnv:HOME}/Git,target=/Users/jay/Git,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make install"
}
